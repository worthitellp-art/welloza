# HTTPS endpoint that accepts POST JSON {"email": "...", "source": "welloza-website"} (Formspree, Zapier, your own API).
# Leave unset and the enquiry form tells visitors it is not connected yet.
ENQUIRY_WEBHOOK_URL=

# Admin panel. Set these with `npx wrangler secret put <NAME>` in production and in .dev.vars locally.
ADMIN_USERNAME=
# Output of: node scripts/hash-password.mjs
ADMIN_PASSWORD_HASH=
# Random value of 32+ characters, for example: openssl rand -base64 32
NEXTAUTH_SECRET=
# Full site address, for example https://www.example.com
NEXTAUTH_URL=
